diff --git a/deps/uv/src/unix/hurd.c b/deps/uv/src/unix/hurd.c
index 99f4f2ae..26521ecf 100644
--- a/deps/uv/src/unix/hurd.c
+++ b/deps/uv/src/unix/hurd.c
@@ -154,6 +154,19 @@ int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
 
   *count = hbi.avail_cpus;
 
+  /* XXX the Hurd does not expose per-CPU information yet.  Fill in the
+   * model string so that consumers such as Node's os.cpus() do not
+   * dereference a NULL pointer. */
+  for (int i = 0; i < *count; i++) {
+    (*cpu_infos)[i].model = uv__strdup("GNU/Hurd CPU");
+    if ((*cpu_infos)[i].model == NULL) {
+      for (int j = 0; j < i; j++) uv__free((*cpu_infos)[j].model);
+      uv__free(*cpu_infos);
+      err = UV_ENOMEM;
+      goto abort;
+    }
+  }
+
   return 0;
   
  abort:
