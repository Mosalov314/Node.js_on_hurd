@@ -596,6 +596,13 @@ bool OS::DiscardSystemPages(void* address, size_t size) {
   if (ret != 0 && errno == EINVAL) {
     ret = madvise(reinterpret_cast<caddr_t>(address), size, MADV_DONTNEED);
   }
+#elif defined(V8_OS_HURD)
+  // GNU/Hurd's madvise(MADV_DONTNEED) is not universally implemented.
+  // Discarding is only an optimization, so ignore unsupported requests.
+  int ret = madvise(address, size, MADV_DONTNEED);
+  if (ret != 0 && (errno == ENOSYS || errno == EINVAL)) {
+    return true;
+  }
 #else
   int ret = madvise(address, size, MADV_DONTNEED);
 #endif
